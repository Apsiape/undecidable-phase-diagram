/-
# Gibbs measures of hard-constraint systems on elementary cylinders

New in this project (session 9). For a finite spin set the product σ-algebra on `I → E` is
generated by the elementary cylinders `cyl J a = {x | x = a on J}` (`J` finite), and the Gibbs
property of a hard-constraint weight system (`HardWeightSystem.IsGibbs`) is a statement about
finitely many cylinder masses at a time:
* `measure_cyl_sdiff`, `measureReal_cyl_sdiff`: for `S ⊆ J`, the cylinder over `J \ S` is the
  disjoint union of the cylinders over `J` given by the fillings of `S`;
* `ext_cyl`, `ext_cyl_cofinal`: two finite measures that agree on the elementary cylinders (over
  a cofinal family of finite sets `J`) are equal (the cylinders form a π-system generating the
  product σ-algebra);
* `HardWeightSystem.fd_of_isGibbs`: a Gibbs measure gives the cylinder over `J ⊇ S ∪ range S` the
  mass `W_S(a) / Z_S(a) · μ(cyl (J \ S) a)` (the DLR identity for the indicator of the cylinder);
  `HardWeightSystem.db_of_isGibbs`: hence detailed balance `DB` on the cylinders over `J`;
* `HardWeightSystem.isGibbs_of_db`: conversely, a probability measure concentrated on the
  configurations with positive weights that satisfies detailed balance for cofinally many `S`,
  each on cofinally many `J`, is Gibbs: the kernel `γ_S` (`cylKernel`) leaves it invariant
  (`cylKernel_comp_eq`, by `ext_cyl_cofinal`), the DLR identity for `S` follows by integrating
  against `γ_S ∘ μ = μ`, and for every smaller set by `dlr_of_superset` (`set:consistency`).
-/
import UndecidablePhaseDiagram.Gibbs.Hard
import Mathlib.Probability.Kernel.Composition.IntegralCompProd
import Mathlib.Probability.Kernel.Composition.MeasureComp

set_option autoImplicit false

noncomputable section

open MeasureTheory ProbabilityTheory
open scoped ENNReal

namespace UPD

namespace Gibbs

variable {I E : Type} [DecidableEq I] [Fintype E] [DecidableEq E] [MeasurableSpace E]
  [DiscreteMeasurableSpace E]

/-! ## Elementary cylinders -/

omit [DecidableEq I] [Fintype E] [DecidableEq E] [MeasurableSpace E]
  [DiscreteMeasurableSpace E] in
/-- The elementary cylinder `{x | x = a on J}`. -/
def cyl (J : Finset I) (a : I → E) : Set (I → E) := {x | ∀ i ∈ J, x i = a i}

omit [DecidableEq I] [Fintype E] [DecidableEq E] [MeasurableSpace E]
  [DiscreteMeasurableSpace E] in
theorem mem_cyl {J : Finset I} {a x : I → E} : x ∈ cyl J a ↔ ∀ i ∈ J, x i = a i := Iff.rfl

omit [DecidableEq E] in
theorem measurableSet_cyl (J : Finset I) (a : I → E) : MeasurableSet (cyl J a) :=
  measurableSet_of_dependsOn J _ fun _ _ h =>
    ⟨fun hx i hi => (h i hi).symm.trans (hx i hi), fun hy i hi => (h i hi).trans (hy i hi)⟩

omit [DecidableEq I] [Fintype E] [DecidableEq E] [MeasurableSpace E]
  [DiscreteMeasurableSpace E] in
theorem cyl_congr {J : Finset I} {a a' : I → E} (h : ∀ i ∈ J, a i = a' i) :
    cyl J a = cyl J a' := by
  ext x
  exact ⟨fun hx i hi => (hx i hi).trans (h i hi), fun hx i hi => (hx i hi).trans (h i hi).symm⟩

omit [Fintype E] [DecidableEq E] [MeasurableSpace E] [DiscreteMeasurableSpace E] in
/-- The cylinder over `J \ S` is the union of the cylinders over `J` given by the fillings of
`S`. -/
theorem cyl_sdiff_eq_iUnion (J S : Finset I) (a : I → E) :
    cyl (J \ S) a = ⋃ ζ : S → E, cyl J (fillOn a S ζ) := by
  ext x
  simp only [Set.mem_iUnion, mem_cyl]
  constructor
  · intro hx
    refine ⟨fun i => x i.1, fun i hi => ?_⟩
    by_cases hiS : i ∈ S
    · rw [fillOn_of_mem a _ hiS]
    · rw [fillOn_of_not_mem a _ hiS]
      exact hx i (Finset.mem_sdiff.2 ⟨hi, hiS⟩)
  · rintro ⟨ζ, hζ⟩ i hi
    obtain ⟨hiJ, hiS⟩ := Finset.mem_sdiff.1 hi
    rw [hζ i hiJ, fillOn_of_not_mem a _ hiS]

omit [Fintype E] [DecidableEq E] [MeasurableSpace E] [DiscreteMeasurableSpace E] in
/-- The cylinders over `J` given by different fillings of `S ⊆ J` are disjoint. -/
theorem pairwise_disjoint_cyl_fillOn {J S : Finset I} (hS : S ⊆ J) (a : I → E) :
    Pairwise (Function.onFun Disjoint fun ζ : S → E => cyl J (fillOn a S ζ)) := by
  intro ζ ζ' hne
  change Disjoint (cyl J (fillOn a S ζ)) (cyl J (fillOn a S ζ'))
  refine Set.disjoint_left.2 fun x hx hx' => hne (funext fun s => ?_)
  have h1 := hx s.1 (hS s.2)
  have h2 := hx' s.1 (hS s.2)
  rw [fillOn_of_mem a ζ s.2] at h1
  rw [fillOn_of_mem a ζ' s.2] at h2
  exact h1.symm.trans h2

omit [DecidableEq E] in
/-- **Partition**: for `S ⊆ J`, the cylinder over `J \ S` is the disjoint union over the fillings
of `S`. -/
theorem measure_cyl_sdiff (μ : Measure (I → E)) {J S : Finset I} (hS : S ⊆ J) (a : I → E) :
    μ (cyl (J \ S) a) = ∑ ζ : S → E, μ (cyl J (fillOn a S ζ)) := by
  rw [cyl_sdiff_eq_iUnion, measure_iUnion (pairwise_disjoint_cyl_fillOn hS a)
    (fun ζ => measurableSet_cyl J _), tsum_fintype]

omit [DecidableEq E] in
/-- **Partition**, real form. -/
theorem measureReal_cyl_sdiff (μ : Measure (I → E)) [IsFiniteMeasure μ] {J S : Finset I}
    (hS : S ⊆ J) (a : I → E) :
    μ.real (cyl (J \ S) a) = ∑ ζ : S → E, μ.real (cyl J (fillOn a S ζ)) := by
  simp only [measureReal_def]
  rw [measure_cyl_sdiff μ hS a, ENNReal.toReal_sum fun ζ _ => measure_ne_top μ _]

omit [Fintype E] [DecidableEq E] [MeasurableSpace E] [DiscreteMeasurableSpace E] in
/-- The elementary cylinders form a π-system. -/
theorem isPiSystem_cyl : IsPiSystem {s : Set (I → E) | ∃ J a, s = cyl J a} := by
  rintro _ ⟨J, a, rfl⟩ _ ⟨K, b, rfl⟩ ⟨x, hxa, hxb⟩
  refine ⟨J ∪ K, x, ?_⟩
  ext y
  simp only [Set.mem_inter_iff, mem_cyl, Finset.mem_union]
  constructor
  · rintro ⟨hya, hyb⟩ i (hi | hi)
    · exact (hya i hi).trans (hxa i hi).symm
    · exact (hyb i hi).trans (hxb i hi).symm
  · intro hy
    exact ⟨fun i hi => (hy i (Or.inl hi)).trans (hxa i hi),
      fun i hi => (hy i (Or.inr hi)).trans (hxb i hi)⟩

omit [DecidableEq E] in
/-- The elementary cylinders generate the product σ-algebra (finite discrete spin set). -/
theorem pi_eq_generateFrom_cyl :
    (MeasurableSpace.pi : MeasurableSpace (I → E)) =
      MeasurableSpace.generateFrom {s : Set (I → E) | ∃ J a, s = cyl J a} := by
  apply le_antisymm
  · refine iSup_le fun i => Measurable.comap_le ?_
    refine @measurable_to_countable' E (I → E) _ _
      (MeasurableSpace.generateFrom {s : Set (I → E) | ∃ J a, s = cyl J a}) _ (fun e => ?_)
    have h : (fun x : I → E => x i) ⁻¹' {e} = cyl {i} (fun _ => e) := by
      ext x
      simp [mem_cyl]
    rw [h]
    exact MeasurableSpace.measurableSet_generateFrom ⟨_, _, rfl⟩
  · exact MeasurableSpace.generateFrom_le fun s ⟨J, a, hs⟩ => hs ▸ measurableSet_cyl J a

omit [DecidableEq E] in
/-- **Uniqueness**: two finite measures that agree on the elementary cylinders are equal. -/
theorem ext_cyl {μ ν : Measure (I → E)} [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    (h : ∀ (J : Finset I) (a : I → E), μ (cyl J a) = ν (cyl J a)) : μ = ν := by
  refine ext_of_generate_finite _ pi_eq_generateFrom_cyl isPiSystem_cyl
    (by rintro _ ⟨J, a, rfl⟩; exact h J a) ?_
  rcases isEmpty_or_nonempty (I → E) with hE | ⟨⟨a⟩⟩
  · rw [Set.univ_eq_empty_iff.2 hE, measure_empty, measure_empty]
  · have hu : (Set.univ : Set (I → E)) = cyl ∅ a := by
      ext x
      simp [mem_cyl]
    rw [hu, h]

omit [DecidableEq E] in
/-- **Uniqueness** from the cylinders over a cofinal family of finite sets. -/
theorem ext_cyl_cofinal {μ ν : Measure (I → E)} [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    (P : Finset I → Prop) (hP : ∀ J₀ : Finset I, ∃ J, J₀ ⊆ J ∧ P J)
    (h : ∀ J, P J → ∀ a : I → E, μ (cyl J a) = ν (cyl J a)) : μ = ν := by
  refine ext_cyl fun J₀ a => ?_
  obtain ⟨J, hJ₀, hJ⟩ := hP J₀
  have hsub : J \ J₀ ⊆ J := Finset.sdiff_subset
  rw [← Finset.sdiff_sdiff_eq_self hJ₀, measure_cyl_sdiff μ hsub, measure_cyl_sdiff ν hsub]
  exact Finset.sum_congr rfl fun ζ _ => h J hJ _

/-! ## Hard-constraint systems on cylinders -/

namespace HardWeightSystem

variable (ws : HardWeightSystem I E)

omit [Fintype E] [DecidableEq E] [DiscreteMeasurableSpace E] in
/-- Detailed balance on the cylinders over `J`: for `a, a'` that agree off `S`,
`μ(cyl J a) W_S(a') = μ(cyl J a') W_S(a)`. -/
def DB (μ : Measure (I → E)) (S J : Finset I) : Prop :=
  ∀ a a' : I → E, (∀ i, i ∉ S → a i = a' i) →
    μ.real (cyl J a) * ws.W S a' = μ.real (cyl J a') * ws.W S a

omit [Fintype E] [DecidableEq E] [MeasurableSpace E] [DiscreteMeasurableSpace E] in
/-- On the cylinder over `J \ S`, `range S ⊆ J`, the weights of the fillings of `S` are those
at `a`. -/
theorem W_fillOn_of_mem_cyl {S J : Finset I} (hr : ws.range S ⊆ J) {a x : I → E}
    (hx : x ∈ cyl (J \ S) a) (ζ : S → E) : ws.W S (fillOn x S ζ) = ws.W S (fillOn a S ζ) := by
  refine ws.isLocal S _ _ fun i hi => ?_
  by_cases hiS : i ∈ S
  · rw [fillOn_of_mem x ζ hiS, fillOn_of_mem a ζ hiS]
  · rw [fillOn_of_not_mem x ζ hiS, fillOn_of_not_mem a ζ hiS]
    exact hx i (Finset.mem_sdiff.2 ⟨hr hi, hiS⟩)

omit [DecidableEq E] [MeasurableSpace E] [DiscreteMeasurableSpace E] in
/-- `Z_S` is constant on the cylinder over `J \ S` when `range S ⊆ J`. -/
theorem Z_of_mem_cyl {S J : Finset I} (hr : ws.range S ⊆ J) {a x : I → E}
    (hx : x ∈ cyl (J \ S) a) : ws.Z S x = ws.Z S a := by
  unfold Z
  exact Finset.sum_congr rfl fun ζ _ => ws.W_fillOn_of_mem_cyl hr hx ζ

omit [DecidableEq E] [MeasurableSpace E] [DiscreteMeasurableSpace E] in
/-- `W_S(x) ≤ Z_S(x)` (the term of the filling by `x` itself). -/
theorem W_le_Z (S : Finset I) (x : I → E) : ws.W S x ≤ ws.Z S x := by
  have h := Finset.single_le_sum (f := fun ζ : S → E => ws.W S (fillOn x S ζ))
    (fun ζ _ => ws.nonneg _ _) (Finset.mem_univ (fun i : S => x i.1))
  simpa only [fillOn_self, Z] using h

omit [DecidableEq E] [MeasurableSpace E] [DiscreteMeasurableSpace E] in
/-- `γ_S` applied to the indicator of the cylinder over `J ⊇ S ∪ range S`: only the filling by
`a` contributes, on the cylinder over `J \ S`. -/
theorem expect_indicator_cyl {S J : Finset I} (hS : S ⊆ J) (hr : ws.range S ⊆ J)
    (a x : I → E) :
    ws.expect S x ((cyl J a).indicator 1) =
      (cyl (J \ S) a).indicator (fun _ => ws.W S a / ws.Z S a) x := by
  unfold expect
  by_cases hx : x ∈ cyl (J \ S) a
  · rw [Set.indicator_of_mem hx]
    rw [Finset.sum_eq_single (fun i : S => a i.1)]
    · have hmem : fillOn x S (fun i : S => a i.1) ∈ cyl J a := fun i hi => by
        by_cases hiS : i ∈ S
        · rw [fillOn_of_mem x _ hiS]
        · rw [fillOn_of_not_mem x _ hiS]
          exact hx i (Finset.mem_sdiff.2 ⟨hi, hiS⟩)
      rw [Set.indicator_of_mem hmem, Pi.one_apply, mul_one, prob,
        ws.W_fillOn_of_mem_cyl hr hx, fillOn_self, ws.Z_of_mem_cyl hr hx]
    · intro ζ _ hne
      have hnot : fillOn x S ζ ∉ cyl J a := fun h => hne (funext fun s => by
        have h1 := h s.1 (hS s.2)
        rwa [fillOn_of_mem x ζ s.2] at h1)
      rw [Set.indicator_of_notMem hnot, mul_zero]
    · intro h
      exact absurd (Finset.mem_univ _) h
  · rw [Set.indicator_of_notMem hx]
    refine Finset.sum_eq_zero fun ζ _ => ?_
    have hnot : fillOn x S ζ ∉ cyl J a := fun h => hx fun i hi => by
      obtain ⟨hiJ, hiS⟩ := Finset.mem_sdiff.1 hi
      have h1 := h i hiJ
      rwa [fillOn_of_not_mem x ζ hiS] at h1
    rw [Set.indicator_of_notMem hnot, mul_zero]

omit [DecidableEq E] in
/-- **Finite-dimensional form of the Gibbs property**: for `S ⊆ J` and `range S ⊆ J`,
`μ(cyl J a) = W_S(a) / Z_S(a) · μ(cyl (J \ S) a)`. -/
theorem fd_of_isGibbs {μ : Measure (I → E)} (hμ : ws.IsGibbs μ) {S J : Finset I} (hS : S ⊆ J)
    (hr : ws.range S ⊆ J) (a : I → E) :
    μ.real (cyl J a) = ws.W S a / ws.Z S a * μ.real (cyl (J \ S) a) := by
  have hA := measurableSet_cyl J a
  have hdlr := hμ.2.2 S ((cyl J a).indicator 1) (measurable_one.indicator hA)
    ⟨1, fun x => by by_cases hx : x ∈ cyl J a <;> simp [Set.indicator, hx]⟩
  rw [integral_indicator_one hA] at hdlr
  rw [hdlr]
  simp only [ws.expect_indicator_cyl hS hr a]
  rw [integral_indicator_const _ (measurableSet_cyl _ a), smul_eq_mul, mul_comm]

omit [DecidableEq E] in
/-- **Detailed balance** of a Gibbs measure on the cylinders over `J ⊇ S ∪ range S`. -/
theorem db_of_isGibbs {μ : Measure (I → E)} (hμ : ws.IsGibbs μ) {S J : Finset I} (hS : S ⊆ J)
    (hr : ws.range S ⊆ J) : ws.DB μ S J := by
  intro a a' h
  have hc : cyl (J \ S) a = cyl (J \ S) a' :=
    cyl_congr fun i hi => h i (Finset.mem_sdiff.1 hi).2
  rw [ws.fd_of_isGibbs hμ hS hr a, ws.fd_of_isGibbs hμ hS hr a', hc, ws.Z_congr h]
  ring

omit [DecidableEq E] in
/-- The probabilities of the fillings are measurable functions of the boundary condition. -/
theorem measurable_prob (S : Finset I) (ζ : S → E) : Measurable (fun x => ws.prob S x ζ) := by
  have hW : Measurable (ws.W S) := measurable_of_dependsOn (ws.range S) _ (ws.isLocal S)
  have hf : ∀ ζ' : S → E, Measurable (fun x : I → E => fillOn x S ζ') := fun ζ' =>
    (measurable_fillOn S ζ').mono cylinderEvents_le_pi le_rfl
  simp only [prob, Z]
  exact (hW.comp (hf ζ)).div (Finset.measurable_sum _ fun ζ' _ => hW.comp (hf ζ'))

omit [DecidableEq E] in
/-- The kernel `γ_S(· | x) = ∑_ζ W_S(x^ζ) / Z_S(x) · δ_{x^ζ}` as a kernel (total mass `1`, or
`0` when `Z_S(x) = 0`). -/
def cylKernel (S : Finset I) : Kernel (I → E) (I → E) where
  toFun x := ∑ ζ : S → E, ENNReal.ofReal (ws.prob S x ζ) • Measure.dirac (fillOn x S ζ)
  measurable' := Measure.measurable_of_measurable_coe _ fun A hA => by
    simp only [Measure.coe_finsetSum, Finset.sum_apply, Measure.smul_apply, smul_eq_mul,
      Measure.dirac_apply' _ hA]
    refine Finset.measurable_sum _ fun ζ _ => ?_
    exact (ws.measurable_prob S ζ).ennreal_ofReal.mul ((measurable_one.indicator hA).comp
      ((measurable_fillOn S ζ).mono cylinderEvents_le_pi le_rfl))

omit [DecidableEq E] in
theorem cylKernel_apply (S : Finset I) (x : I → E) :
    ws.cylKernel S x =
      ∑ ζ : S → E, ENNReal.ofReal (ws.prob S x ζ) • Measure.dirac (fillOn x S ζ) :=
  rfl

omit [DecidableEq E] in
theorem cylKernel_apply_set (S : Finset I) (x : I → E) {A : Set (I → E)}
    (hA : MeasurableSet A) :
    ws.cylKernel S x A = ENNReal.ofReal (ws.expect S x (A.indicator 1)) := by
  have hnn : ∀ ζ : S → E, 0 ≤ ws.prob S x ζ * A.indicator (1 : (I → E) → ℝ) (fillOn x S ζ) :=
    fun ζ => mul_nonneg (ws.prob_nonneg _ _ _) (Set.indicator_nonneg (fun _ _ => zero_le_one) _)
  rw [expect, ENNReal.ofReal_sum_of_nonneg fun ζ _ => hnn ζ]
  simp only [cylKernel_apply, Measure.coe_finsetSum, Finset.sum_apply, Measure.smul_apply,
    smul_eq_mul, Measure.dirac_apply' _ hA]
  refine Finset.sum_congr rfl fun ζ _ => ?_
  rw [ENNReal.ofReal_mul (ws.prob_nonneg _ _ _)]
  congr 1
  by_cases h : fillOn x S ζ ∈ A <;> simp [h]

omit [DecidableEq E] in
instance (S : Finset I) : IsFiniteKernel (ws.cylKernel S) :=
  ⟨⟨1, ENNReal.one_lt_top, fun x => by
    rw [ws.cylKernel_apply_set S x MeasurableSet.univ]
    simp only [Set.indicator_univ, expect, Pi.one_apply, mul_one]
    exact ENNReal.ofReal_le_one.2 (ws.sum_prob_le_one S x)⟩⟩

omit [DecidableEq E] in
/-- `∫ F dγ_S(· | x) = (γ_S F)(x)` for bounded measurable `F`. -/
theorem integral_cylKernel (S : Finset I) (x : I → E) {F : (I → E) → ℝ} (hF : Measurable F)
    (hb : ∃ C : ℝ, ∀ η, |F η| ≤ C) : ∫ η, F η ∂(ws.cylKernel S x) = ws.expect S x F := by
  obtain ⟨C, hC⟩ := hb
  have hint : ∀ ζ : S → E, Integrable F
      (ENNReal.ofReal (ws.prob S x ζ) • Measure.dirac (fillOn x S ζ)) := fun ζ =>
    (Integrable.of_bound hF.aestronglyMeasurable C
      (ae_of_all _ fun η => by rw [Real.norm_eq_abs]; exact hC η)).smul_measure
      ENNReal.ofReal_ne_top
  rw [cylKernel_apply, integral_finsetSum_measure fun ζ _ => hint ζ]
  unfold expect
  refine Finset.sum_congr rfl fun ζ _ => ?_
  rw [integral_smul_measure, integral_dirac' F _ hF.stronglyMeasurable,
    ENNReal.toReal_ofReal (ws.prob_nonneg _ _ _), smul_eq_mul]

omit [DecidableEq E] in
/-- `γ_S(cyl J a | x) = W_S(a) / Z_S(a)` on the cylinder over `J \ S`, `0` off it. -/
theorem cylKernel_cyl {S J : Finset I} (hS : S ⊆ J) (hr : ws.range S ⊆ J) (a x : I → E) :
    ws.cylKernel S x (cyl J a) =
      (cyl (J \ S) a).indicator (fun _ => ENNReal.ofReal (ws.W S a / ws.Z S a)) x := by
  rw [ws.cylKernel_apply_set S x (measurableSet_cyl J a), ws.expect_indicator_cyl hS hr a x]
  by_cases hx : x ∈ cyl (J \ S) a <;> simp [Set.indicator, hx]

omit [DecidableEq E] in
/-- Detailed balance on the cylinders over `J` makes `γ_S ∘ μ` and `μ` agree on them. -/
theorem cylKernel_comp_cyl {μ : Measure (I → E)} [IsFiniteMeasure μ]
    (hpos : ∀ᵐ x ∂μ, ∀ Λ : Finset I, 0 < ws.W Λ x) {S J : Finset I} (hS : S ⊆ J)
    (hr : ws.range S ⊆ J) (hdb : ws.DB μ S J) (a : I → E) :
    (ws.cylKernel S ∘ₘ μ) (cyl J a) = μ (cyl J a) := by
  rw [Measure.bind_apply (measurableSet_cyl J a) (ws.cylKernel S).aemeasurable]
  simp only [ws.cylKernel_cyl hS hr a]
  rw [lintegral_indicator_const (measurableSet_cyl _ a)]
  -- `W_S(a) μ(cyl (J \ S) a) = μ(cyl J a) Z_S(a)`, by the partition and detailed balance
  have hsum : ws.W S a * μ.real (cyl (J \ S) a) = μ.real (cyl J a) * ws.Z S a := by
    rw [measureReal_cyl_sdiff μ hS a, Finset.mul_sum, Z, Finset.mul_sum]
    refine Finset.sum_congr rfl fun ζ _ => ?_
    rw [hdb a (fillOn a S ζ) fun i hi => (fillOn_of_not_mem a ζ hi).symm]
    ring
  have hreal : ws.W S a / ws.Z S a * μ.real (cyl (J \ S) a) = μ.real (cyl J a) := by
    by_cases hZ : ws.Z S a = 0
    · rw [hZ, div_zero, zero_mul]
      -- `Z_S = 0` on `cyl J a`, which is then null since `W_S > 0` almost everywhere
      have hnull : μ (cyl J a) = 0 := by
        refine measure_mono_null (fun x hx => ?_) (ae_iff.1 hpos)
        have hx' : x ∈ cyl (J \ S) a := fun i hi => hx i (Finset.mem_sdiff.1 hi).1
        have hZx : ws.Z S x = 0 := (ws.Z_of_mem_cyl hr hx').trans hZ
        simp only [Set.mem_setOf_eq, not_forall, not_lt]
        exact ⟨S, (ws.W_le_Z S x).trans hZx.le⟩
      rw [measureReal_def, hnull, ENNReal.toReal_zero]
    · rw [div_mul_eq_mul_div, hsum, mul_div_assoc, div_self hZ, mul_one]
  have h2 := congrArg ENNReal.ofReal hreal
  rwa [ENNReal.ofReal_mul (div_nonneg (ws.nonneg _ _) (ws.Z_nonneg _ _)),
    ofReal_measureReal (measure_ne_top μ (cyl (J \ S) a)),
    ofReal_measureReal (measure_ne_top μ (cyl J a))] at h2

omit [DecidableEq E] in
/-- **Invariance**: detailed balance on cofinally many cylinders gives `γ_S ∘ μ = μ`. -/
theorem cylKernel_comp_eq {μ : Measure (I → E)} [IsFiniteMeasure μ]
    (hpos : ∀ᵐ x ∂μ, ∀ Λ : Finset I, 0 < ws.W Λ x) {S : Finset I}
    (h : ∀ J₀ : Finset I, ∃ J, J₀ ⊆ J ∧ S ⊆ J ∧ ws.range S ⊆ J ∧ ws.DB μ S J) :
    ws.cylKernel S ∘ₘ μ = μ :=
  ext_cyl_cofinal (fun J => S ⊆ J ∧ ws.range S ⊆ J ∧ ws.DB μ S J) h
    (fun _ hJ a => ws.cylKernel_comp_cyl hpos hJ.1 hJ.2.1 hJ.2.2 a)

/-- **Gibbs from detailed balance**: a probability measure concentrated on the configurations
with positive weights that satisfies detailed balance for cofinally many `S`, each on the
cylinders over cofinally many `J ⊇ S ∪ range S`, is Gibbs. -/
theorem isGibbs_of_db {μ : Measure (I → E)} [IsProbabilityMeasure μ]
    (hpos : ∀ᵐ x ∂μ, ∀ Λ : Finset I, 0 < ws.W Λ x)
    (h : ∀ S₀ : Finset I, ∃ S, S₀ ⊆ S ∧ ∀ J₀ : Finset I, ∃ J, J₀ ⊆ J ∧ S ⊆ J ∧
      ws.range S ⊆ J ∧ ws.DB μ S J) : ws.IsGibbs μ := by
  refine ⟨inferInstance, hpos, fun S₀ F hF hb => ?_⟩
  obtain ⟨S, hS₀, hJ⟩ := h S₀
  refine ws.dlr_of_superset hS₀ (fun G hG ⟨C, hC⟩ => ?_) F hF hb
  have hcomp := ws.cylKernel_comp_eq hpos hJ
  have hint : Integrable G (ws.cylKernel S ∘ₘ μ) := by
    rw [hcomp]
    exact Integrable.of_bound hG.aestronglyMeasurable C
      (ae_of_all _ fun x => by rw [Real.norm_eq_abs]; exact hC x)
  calc ∫ x, G x ∂μ = ∫ x, G x ∂(ws.cylKernel S ∘ₘ μ) := by rw [hcomp]
    _ = ∫ x, ∫ y, G y ∂(ws.cylKernel S x) ∂μ := by
        rw [Measure.comp_eq_comp_const_apply] at hint ⊢
        rw [Kernel.integral_comp hint, Kernel.const_apply]
    _ = ∫ x, ws.expect S x G ∂μ := by
        refine integral_congr_ae (ae_of_all _ fun x => ?_)
        exact ws.integral_cylKernel S x hG ⟨C, hC⟩

end HardWeightSystem

